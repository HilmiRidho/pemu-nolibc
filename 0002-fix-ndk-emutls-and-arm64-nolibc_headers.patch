From b7071b7d030df6c3c4a93303b38d7f553f918453 Mon Sep 17 00:00:00 2001
From: pemu fix <fix@example.invalid>
Date: Fri, 20 Nov 2026 08:23:26 +0000
Subject: [PATCH] build: fix Android NDK link (emulated TLS) and arm64
 nolibc_headers check

CI run 120994850438: debian amd64 passes now. Two jobs still failed, both
were hidden behind the earlier failures.

* termux aarch64: "undefined symbol: pthread_getspecific / pthread_setspecific /
  pthread_key_create / pthread_key_delete" from compiler-rt's emutls.c. The NDK
  clang emulates __thread for API < 29 through emutls, which needs libc's
  pthread keys. host/rt/ sets up native TLS itself (rt_tls_setup), so build with
  -fno-emulated-tls (probed; gcc does not have the flag).

* debian arm64: integration/nolibc_headers listed __aarch64_cas*/ldadd*/swp*
  and __lshrti3 as undefined. The test compiled without the -mno-outline-atomics
  that build.sh now uses, so gcc 12 emitted the LSE helper calls; use the same
  probed flag there. __lshrti3 (also ashl/ashrti3) is a libgcc 128-bit shift,
  like the __udivti3 already allowed: add it to the allowed list.
---
 build.sh                            | 6 +++++-
 tests/integration/nolibc_headers.sh | 8 +++++---
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/build.sh b/build.sh
index 81c3833..a52433e 100644
--- a/build.sh
+++ b/build.sh
@@ -48,7 +48,11 @@ esac
 # __getauxval from a libc: not linked here.  Inline LL/SC atomics instead (the JIT picks its own LSE paths at run time).  Probed: x86_64 gcc has no such flag.
 NOOA=""
 echo 'int x;' | $CC -Werror -mno-outline-atomics -x c -c - -o /dev/null 2>/dev/null && NOOA="-mno-outline-atomics"
-LDS="-static-pie -fPIE -nostdlib -nostdinc -I$(pwd)/host/abi/include -U_FORTIFY_SOURCE -fno-math-errno -fno-stack-protector -falign-functions=64 -falign-jumps=16 $NOOA"
+# clang for Android API < 29 (the NDK default) emulates __thread through compiler-rt's emutls.c, which calls pthread_key_create / pthread_getspecific:
+# not linked here.  host/rt/ sets up real TLS itself (PT_TLS + the thread pointer, rt_tls_setup), so ask for native TLS.  Probed: gcc does not know the flag.
+NOET=""
+echo 'int x;' | $CC -Werror -fno-emulated-tls -x c -c - -o /dev/null 2>/dev/null && NOET="-fno-emulated-tls"
+LDS="-static-pie -fPIE -nostdlib -nostdinc -I$(pwd)/host/abi/include -U_FORTIFY_SOURCE -fno-math-errno -fno-stack-protector -falign-functions=64 -falign-jumps=16 $NOOA $NOET"
 # The compiler's runtime library: libgcc.a for gcc, libclang_rt.builtins-*.a for clang with compiler-rt (Android NDK has no libgcc.a, so -lgcc fails there).
 # Ask the compiler for its file; fall back to -lgcc when it names none that exists.
 MATH="-lgcc"
diff --git a/tests/integration/nolibc_headers.sh b/tests/integration/nolibc_headers.sh
index c79c316..af75bce 100644
--- a/tests/integration/nolibc_headers.sh
+++ b/tests/integration/nolibc_headers.sh
@@ -1,11 +1,13 @@
 #!/bin/sh
 # The build reads no header of the system: compile with -nostdinc and only host/abi/include on the path.
-#  - the host's own compiler: pemu compiles to an object, `nm -u` shows nothing but the compiler's own symbols (libgcc soft-float, __clear_cache, linker symbols)
+#  - the host's own compiler: pemu compiles to an object, `nm -u` shows nothing but the compiler's own symbols (libgcc soft-float and 128-bit shifts, __clear_cache, linker symbols)
 #  - clang for aarch64 (when present): src/pemu.c compiles for an aarch64 host too, without any aarch64 sysroot
 CC=${CC:-gcc}; D=$(mktemp -d); trap 'rm -rf "$D"' EXIT; R=$(cd "$(dirname "$0")/../.." && pwd); I="-nostdinc -I$R/host/abi/include -DPEMU_RELEASE=\"t\" -fno-stack-protector -Werror=implicit-function-declaration -w"
-OK='^(__(add|sub|mul|div|udiv|mod|umod|eq|ne|lt|le|gt|ge|unord|ext|trunc|fix|float|neg|cmp|popcount[a-z]*|clear_cache|ehdr_start|executable_start|init_array|fini_array|preinit_array|bswap)|_?etext|bcmp|memcpy|memset|memmove|memcmp|_GLOBAL_OFFSET_TABLE_|_DYNAMIC)'
+OK='^(__(add|sub|mul|div|udiv|mod|umod|eq|ne|lt|le|gt|ge|unord|ext|trunc|fix|float|neg|cmp|popcount[a-z]*|lshrti|ashlti|ashrti|clear_cache|ehdr_start|executable_start|init_array|fini_array|preinit_array|bswap)|_?etext|bcmp|memcpy|memset|memmove|memcmp|_GLOBAL_OFFSET_TABLE_|_DYNAMIC)'
 check() {  # $1 compiler + flags, $2 source, $3 label
-  $1 -c -O2 -fPIE $I "$R/$2" -o "$D/o.o" || { echo "nolibc_headers: $3: compile failed"; exit 1; }
+  # same as build.sh: no outline-atomics helpers (they come with an init constructor that needs a libc); probed, x86_64 gcc has no such flag
+  OA=""; echo 'int x;' | $1 -Werror -mno-outline-atomics -x c -c - -o /dev/null 2>/dev/null && OA="-mno-outline-atomics"
+  $1 -c -O2 -fPIE $OA $I "$R/$2" -o "$D/o.o" || { echo "nolibc_headers: $3: compile failed"; exit 1; }
   bad=$(nm -u "$D/o.o" 2>/dev/null || llvm-nm -u "$D/o.o") ; bad=$(echo "$bad" | awk '{print $NF}' | grep -Ev "$OK" | grep -v '^$')
   [ -z "$bad" ] || { echo "nolibc_headers: $3: undefined symbols: $bad"; exit 1; }
   echo "nolibc_headers: $3: ok (no system header, no libc symbol)"
-- 
