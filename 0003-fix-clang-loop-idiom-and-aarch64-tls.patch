From 93cbfcffe011341383bee7297e52032b081d1bda Mon Sep 17 00:00:00 2001
From: pemu fix <fix@example.invalid>
Date: Fri, 20 Nov 2026 08:40:29 +0000
Subject: [PATCH] rt: fix SIGSEGV of the clang (Android NDK / Termux) build:
 loop idioms and aarch64 TLS layout

* RT_NOPAT (host/rt/rt_mem.h) was only defined for gcc (optimize attribute).
  clang ignores it ("unknown attribute 'optimize'") and its loop-idiom pass
  rewrites the byte loops of memcpy / memset / strlen / ... into calls to
  memcpy / memset / strlen: the functions call themselves, endless recursion,
  SIGSEGV at the first call. Use no_builtin (no arguments) with clang.

* aarch64 TLS (host/rt/rt_core.h, rt_tls_setup): place the TLS block where the
  linkers' variant I formula puts it (tp aligned to the TLS alignment, block at
  tp + 16 + ((p_vaddr - 16) & (align - 1))). The old placement matched only for
  align <= 16 and p_vaddr a multiple of it; any larger alignment (lld raises
  PT_TLS alignment for Android) put every __thread variable on the wrong
  address. x86_64 (variant II) is unchanged.
---
 host/rt/rt_core.h | 14 +++++++++-----
 host/rt/rt_mem.h  | 13 ++++++++++++-
 2 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/host/rt/rt_core.h b/host/rt/rt_core.h
index 1f90f82..f38ca6c 100644
--- a/host/rt/rt_core.h
+++ b/host/rt/rt_core.h
@@ -47,7 +47,7 @@ struct rt_tcb {
 } __attribute__((aligned(16)));
 struct rt_thr { struct rt_thr *next; char *base; size_t size; struct rt_tcb *tcb; };
 
-static struct { Elf64_Addr img; size_t filesz, memsz, align; } rt_tls;     /* PT_TLS of this image */
+static struct { Elf64_Addr img, vaddr; size_t filesz, memsz, align; } rt_tls;     /* PT_TLS of this image */
 static size_t rt_tls_len(void) { size_t a = rt_tls.align ? rt_tls.align : 1; return (rt_tls.memsz + a - 1) & ~(a - 1); }
 
 #if defined(__x86_64__)
@@ -71,9 +71,13 @@ static struct rt_tcb *rt_tls_setup(char *mem, size_t len) {
     t = (struct rt_tcb *) tp; (void) len;
     char *blk = tp - tl;
 #else
-    t = (struct rt_tcb *) (((uintptr_t) mem + al - 1) & ~(uintptr_t) (al - 1));
-    char *blk = (char *) (t + 1) + 16 - 16;
-    blk = (char *) (((uintptr_t) blk + 16 + (rt_tls.align ? rt_tls.align : 1) - 1) & ~(uintptr_t) ((rt_tls.align ? rt_tls.align : 1) - 1));
+    /* variant I the way the linkers (GNU ld, lld, also for Android) bake it into the code: tp is aligned to the TLS alignment, the 16 bytes at tp are the
+     * TCB, the TLS block is at tp + 16 + ((p_vaddr - 16) & (align - 1)).  The old placement (align_up(tp + 16, align)) agrees only when align <= 16 and
+     * p_vaddr is a multiple of it: with a larger alignment (lld raises it on Android) every __thread variable lay on the wrong address. */
+    size_t A = rt_tls.align ? rt_tls.align : 1;
+    char *tp = (char *) (((uintptr_t) mem + sizeof(struct rt_tcb) + al - 1) & ~(uintptr_t) (al - 1));
+    t = (struct rt_tcb *) (tp - sizeof(struct rt_tcb));
+    char *blk = tp + 16 + (((size_t) rt_tls.vaddr - 16) & (A - 1));
     (void) len;
 #endif
     for (size_t i = 0; i < tl; i++) blk[i] = 0;
@@ -273,7 +277,7 @@ RT_ATTR_USED static void rt_start_c(long *sp) {
         else if (a->a_type == AT_SYSINFO_EHDR) rt_auxv_vdso = a->a_un.a_val;
     }
     for (size_t i = 0; ph && i < phn; i++)
-        if (ph[i].p_type == PT_TLS) { rt_tls.img = (Elf64_Addr) (base + ph[i].p_vaddr); rt_tls.filesz = ph[i].p_filesz; rt_tls.memsz = ph[i].p_memsz; rt_tls.align = ph[i].p_align; }
+        if (ph[i].p_type == PT_TLS) { rt_tls.img = (Elf64_Addr) (base + ph[i].p_vaddr); rt_tls.vaddr = ph[i].p_vaddr; rt_tls.filesz = ph[i].p_filesz; rt_tls.memsz = ph[i].p_memsz; rt_tls.align = ph[i].p_align; }
     size_t tot = (rt_tls_total() + 4095) & ~(size_t) 4095;
     char *m = (char *) rt_raw(SYS_mmap, 0, tot, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
     if ((unsigned long) m > (unsigned long) -4096L) _exit(127);
diff --git a/host/rt/rt_mem.h b/host/rt/rt_mem.h
index 2f3ffef..def65b5 100644
--- a/host/rt/rt_mem.h
+++ b/host/rt/rt_mem.h
@@ -4,8 +4,19 @@
 #include <ctype.h>
 #include <limits.h>
 
-/* the compiler must not turn these loops back into calls to themselves */
+/* the compiler must not turn these loops back into calls to themselves.  gcc: the optimize attribute.  clang ignores that attribute (warning "unknown attribute
+ * 'optimize'") but its loop-idiom pass does the same rewrite (a copy / fill / strlen loop becomes a call to memcpy / memset / strlen, here inside memcpy / memset /
+ * strlen themselves: endless recursion, SIGSEGV at the first call; the Android NDK build is clang).  no_builtin without arguments: no library call is recognised
+ * or generated in this function. */
+#if defined(__clang__)
+#if __has_attribute(no_builtin)
+#define RT_NOPAT __attribute__((no_builtin))
+#else
+#define RT_NOPAT __attribute__((optnone))
+#endif
+#else
 #define RT_NOPAT __attribute__((optimize("no-tree-loop-distribute-patterns")))
+#endif
 
 typedef unsigned long long __attribute__((may_alias, aligned(1))) rt_u64u;
 typedef unsigned int __attribute__((may_alias, aligned(1))) rt_u32u;
-- 
2.43.0

